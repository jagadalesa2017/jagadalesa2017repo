{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "akashhealthcareprojectdataengineeringdev"
		},
		"AzureDatabricks2_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks2'"
		},
		"ls_adls_to_adls_ak_dev_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_to_adls_ak_dev'"
		},
		"ls_srcsqldb_adls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_srcsqldb_adls'"
		},
		"ls_adls_to_adls_ak_dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlahealthcareproject.dfs.core.windows.net/"
		},
		"ls_srcsqldb_adls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mssqlhealthcareakashdev.database.windows.net"
		},
		"ls_srcsqldb_adls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ASQL_HealthCareProject_Akash_DEV"
		},
		"ls_srcsqldb_adls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "akashhealthcareprojectdataengineeringdev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricks2_accessToken": {
						"value": "[parameters('AzureDatabricks2_accessToken')]"
					},
					"ls_adls_to_adls_ak_dev_accountKey": {
						"value": "[parameters('ls_adls_to_adls_ak_dev_accountKey')]"
					},
					"ls_srcsqldb_adls_password": {
						"value": "[parameters('ls_srcsqldb_adls_password')]"
					},
					"ls_adls_to_adls_ak_dev_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_to_adls_ak_dev_properties_typeProperties_url')]"
					},
					"ls_srcsqldb_adls_properties_typeProperties_server": {
						"value": "[parameters('ls_srcsqldb_adls_properties_typeProperties_server')]"
					},
					"ls_srcsqldb_adls_properties_typeProperties_database": {
						"value": "[parameters('ls_srcsqldb_adls_properties_typeProperties_database')]"
					},
					"ls_srcsqldb_adls_properties_typeProperties_userName": {
						"value": "[parameters('ls_srcsqldb_adls_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}