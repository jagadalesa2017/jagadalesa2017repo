											"NewWatermark": {
												"value": {
													"value": "@activity('Get Metadata2').output.lastModified",
													"type": "Expression"
												},
												"type": "DateTime"
											},
											"TableName": {
												"value": {
													"value": "@item().name",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "ls_srcsqldb_adls",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
